# Optional override: international WhatsApp number, https://wa.me/<number>,
# or https://api.whatsapp.com/message/<code>. Empty/invalid uses the
# confirmed public customer-service link in src/data/publicContacts.ts.
VITE_WHATSAPP_CONTACT=
# Optional kill switch for M05 first-party click collection (default enabled).
VITE_CONTACT_ANALYTICS_ENABLED=true
