{
  "name": "studio-huanyu-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "expert:dev": "vite --config expert-review/vite.config.ts",
    "expert:build": "vue-tsc --noEmit -p expert-review/tsconfig.json && vite build --config expert-review/vite.config.ts",
    "audit:figma": "node scripts/audit-figma-specs.mjs",
    "audit:figma:home-source": "node scripts/audit-home-source.mjs",
    "audit:figma:changes": "node scripts/figma-source-gate.cjs",
    "test:figma-source-gate": "node --test scripts/figma-source-gate.test.cjs",
    "audit:i18n": "node scripts/audit-contact-i18n.mjs",
    "audit:i18n:site": "node scripts/site-i18n-catalog.mjs audit",
    "i18n:extract": "node scripts/site-i18n-catalog.mjs extract",
    "i18n:translate": "node scripts/site-i18n-catalog.mjs translate",
    "test:whatsapp": "node --test scripts/whatsapp-prefill.test.cjs",
    "test:analytics": "node --test scripts/contact-analytics.test.cjs",
    "prebuild": "node scripts/audit-contact-i18n.mjs && node scripts/site-i18n-catalog.mjs audit && pnpm run audit:figma && node scripts/optimize-release-images.mjs",
    "build": "vue-tsc -b && vite build",
    "build:app": "node scripts/audit-contact-i18n.mjs && node scripts/site-i18n-catalog.mjs audit && node scripts/optimize-release-images.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:i18n:layout": "node --test scripts/site-i18n-layout.test.cjs",
    "test:i18n:copy": "node --test scripts/site-i18n-copy.test.cjs",
    "qa:i18n:site": "node scripts/site-i18n-qa.cjs",
    "qa:i18n:states": "node scripts/site-i18n-states-qa.cjs",
    "qa:i18n:stress": "node scripts/site-i18n-qa.cjs --stress",
    "qa:m10": "node scripts/m10-boot-qa.cjs"
  },
  "dependencies": {
    "@vant/touch-emulator": "^1.4.0",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.3.0",
    "vant": "^4.9.14",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
